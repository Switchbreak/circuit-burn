[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D Rock_Color : source_color;
uniform sampler2D Grass_Color : source_color;
uniform sampler2D curve_frg_24 : repeat_disable;
uniform sampler2D Rock_Roughness;
uniform sampler2D Grass_Roughness;
uniform sampler2D Rock_Normal_Map : hint_normal;
uniform sampler2D Grass_Normal_Map : hint_normal;


// TextureParameterTriplanar
	vec4 triplanar_texture(sampler2D p_sampler, vec3 p_weights, vec3 p_triplanar_pos) {
		vec4 samp = vec4(0.0);
		samp += texture(p_sampler, p_triplanar_pos.xy) * p_weights.z;
		samp += texture(p_sampler, p_triplanar_pos.xz) * p_weights.y;
		samp += texture(p_sampler, p_triplanar_pos.zy * vec2(-1.0, 1.0)) * p_weights.x;
		return samp;
	}

	uniform vec3 triplanar_scale = vec3(1.0, 1.0, 1.0);
	uniform vec3 triplanar_offset;
	uniform float triplanar_sharpness = 0.5;

	varying vec3 triplanar_power_normal;
	varying vec3 triplanar_pos;

void vertex() {
// TextureParameterTriplanar
	{
		triplanar_power_normal = pow(abs(NORMAL), vec3(triplanar_sharpness));
		triplanar_power_normal /= dot(triplanar_power_normal, vec3(1.0));
		triplanar_pos = VERTEX * triplanar_scale + triplanar_offset;
		triplanar_pos *= vec3(1.0, -1.0, 1.0);
	}
}

void fragment() {
// TextureParameterTriplanar:14
	vec4 n_out14p0 = triplanar_texture(Rock_Color, triplanar_power_normal, triplanar_pos);


// TextureParameterTriplanar:19
	vec4 n_out19p0 = triplanar_texture(Grass_Color, triplanar_power_normal, triplanar_pos);


// Input:13
	vec3 n_out13p0 = NORMAL;
	float n_out13p2 = n_out13p0.g;


// CurveTexture:24
	float n_out24p0 = texture(curve_frg_24, vec2(n_out13p2)).r;


// Mix:22
	vec4 n_out22p0 = mix(n_out14p0, n_out19p0, n_out24p0);


// TextureParameterTriplanar:16
	vec4 n_out16p0 = triplanar_texture(Rock_Roughness, triplanar_power_normal, triplanar_pos);


// VectorDecompose:17
	float n_out17p0 = vec3(n_out16p0.xyz).x;
	float n_out17p1 = vec3(n_out16p0.xyz).y;
	float n_out17p2 = vec3(n_out16p0.xyz).z;


// TextureParameterTriplanar:20
	vec4 n_out20p0 = triplanar_texture(Grass_Roughness, triplanar_power_normal, triplanar_pos);


// Mix:23
	vec4 n_out23p0 = mix(vec4(n_out17p1), n_out20p0, n_out24p0);


// TextureParameterTriplanar:15
	vec4 n_out15p0 = triplanar_texture(Rock_Normal_Map, triplanar_power_normal, triplanar_pos);


// TextureParameterTriplanar:21
	vec4 n_out21p0 = triplanar_texture(Grass_Normal_Map, triplanar_power_normal, triplanar_pos);


// Mix:6
	vec4 n_out6p0 = mix(n_out15p0, n_out21p0, n_out24p0);


// Output:0
	ALBEDO = vec3(n_out22p0.xyz);
	ROUGHNESS = n_out23p0.x;
	NORMAL_MAP = vec3(n_out6p0.xyz);


}
"
